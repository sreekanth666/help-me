<h2 style="font-family: Arial, sans-serif; color: #000000; font-size: 16pt; font-weight: 700; margin-top: 16pt; margin-bottom: 4pt">Implementation Notes</h2>
<p style="font-family: Arial, sans-serif; font-size: 11pt; color: #000000; margin-top: 0; margin-bottom: 10pt">The retry helper now caps total elapsed time rather than attempt count<sup style="vertical-align: super; font-size: 8pt">[1]</sup>:</p>
<pre style="font-family: &quot;Courier New&quot;, monospace; font-size: 10pt; background-color: #f8f9fa; color: #202124; border: 1pt solid #dadce0; padding: 8pt; white-space: pre-wrap; margin-top: 0; margin-bottom: 10pt"><code style="font-family: &quot;Courier New&quot;, monospace; font-size: 10pt; color: #202124"><span style="color: #d73a49">async</span> <span style="color: #d73a49">function</span> <span style="color: #6f42c1">withRetry</span>(operation, budgetMs = <span style="color: #005cc5">5000</span>) {
  <span style="color: #d73a49">const</span> deadline = <span style="color: #6f42c1">Date</span>.<span style="color: #6f42c1">now</span>() + budgetMs
  <span style="color: #d73a49">let</span> delay = <span style="color: #005cc5">100</span>

  <span style="color: #d73a49">while</span> (<span style="color: #6f42c1">Date</span>.<span style="color: #6f42c1">now</span>() &lt; deadline) {
    <span style="color: #d73a49">try</span> {
      <span style="color: #d73a49">return</span> <span style="color: #d73a49">await</span> <span style="color: #6f42c1">operation</span>()
    } <span style="color: #d73a49">catch</span> (error) {
      <span style="color: #d73a49">if</span> (<span style="color: #6f42c1">Date</span>.<span style="color: #6f42c1">now</span>() + delay &gt;= deadline) <span style="color: #d73a49">throw</span> error
      <span style="color: #d73a49">await</span> <span style="color: #6f42c1">sleep</span>(delay)
      delay *= <span style="color: #005cc5">2</span>
    }
  }
}
</code></pre>
<p style="font-family: Arial, sans-serif; font-size: 11pt; color: #000000; margin-top: 0; margin-bottom: 10pt">Configuration lives in a plain block with no language tag:</p>
